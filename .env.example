# Binance Spot TESTNET keys (https://testnet.binance.vision, "Log In with GitHub").
# Never commit real values. Either fill these two lines in a local .env ...
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
# ... or keep keys outside the repo and point to the file(s), comma separated:
# COVERME_KEYS_FILE=/absolute/path/binance-testnet.env

# Optional: private iCal address. Meetings then start and end the cover by themselves. Treat it like a password.
# COVERME_ICAL_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Optional
# COVERME_PORT=8787
# COVERME_LINE_PCT=2.0        # ask when the best bid falls this % below the price at start
# COVERME_GUARD_BTC=0.020     # the amount Cover Me watches (and the most it can sell)
# COVERME_COVER_MIN=30        # length of a manual cover
# COVERME_ALLOW_ORIGIN=http://localhost:5173
